# HarborVision Twin safe local configuration template.
# Copy to .env; never commit the resulting .env file.

# Runtime mode: development, test, or production.
# Production rejects the default JWT secret.
ENVIRONMENT=development

# Local zero-service database. Docker overrides this with PostgreSQL/PostGIS.
DATABASE_URL=sqlite:///./harborvision.db

# Required. Use at least 32 random bytes and replace before any shared deployment.
JWT_SECRET=replace-this-with-at-least-32-random-bytes

# Access-token lifetime in minutes and refresh-token lifetime in days.
TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=14

# Repository-relative local evidence/report storage.
STORAGE_DIR=./data/generated

# Explicit comma-separated browser origins. Do not use wildcard origins with credentials.
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Optional locally; Docker and production deployments should configure Redis.
REDIS_URL=redis://localhost:6379/0
WORKER_STALE_SECONDS=120

# Upload policy values reserved for image/video ingestion adapters.
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=262144000

# Docker-only local service settings. Replace before sharing the environment.
POSTGRES_DB=harborvision
POSTGRES_USER=harborvision
POSTGRES_PASSWORD=harborvision-local-only-change-me
MINIO_ROOT_USER=harborvision
MINIO_ROOT_PASSWORD=harborvision-local-only-change-me
